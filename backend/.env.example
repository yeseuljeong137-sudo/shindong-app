PORT=3000
JWT_SECRET="여기에-긴-랜덤-문자열을-넣으세요"

# Supabase (PostgreSQL) 연결 주소
# Supabase 대시보드 → 프로젝트(shindong) → 상단 Connect 버튼에서 복사
# [YOUR-PASSWORD] 자리에 프로젝트 만들 때 정한 DB 비밀번호를 넣으세요 (특수문자가 있으면 percent-encode 필요)

# Transaction pooler (포트 6543, 끝에 ?pgbouncer=true) — 서버가 평소에 사용
DATABASE_URL="postgresql://postgres.ocsyhxdhyqotapknkuqu:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (포트 5432) — npx prisma migrate 할 때 사용
DIRECT_URL="postgresql://postgres.ocsyhxdhyqotapknkuqu:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
